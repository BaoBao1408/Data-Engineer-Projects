# ═══════════════════════════════════════════════════════════════
#  adstart Pipeline — Environment Variables
#  Copy file này thành .env và điền giá trị thật
#  ⚠️  KHÔNG commit file .env lên git (đã có trong .gitignore)
# ═══════════════════════════════════════════════════════════════

# ── Chọn môi trường ─────────────────────────────────────────────
# local = DuckDB + local CSV (cho dev/test không cần AWS)
# aws   = S3 + Athena + Glue (cho production)
PIPELINE_ENV=local

# ── AWS Settings (chỉ cần khi PIPELINE_ENV=aws) ─────────────────
AWS_REGION=eu-west-1

# Bucket names — điền account ID của bạn (12 chữ số)
# Lấy bằng: aws sts get-caller-identity --query Account --output text
AWS_RAW_BUCKET=adstart-raw-YOUR_ACCOUNT_ID
AWS_WAREHOUSE_BUCKET=adstart-warehouse-YOUR_ACCOUNT_ID
AWS_ATHENA_OUTPUT_BUCKET=adstart-athena-results-YOUR_ACCOUNT_ID

# Glue Catalog databases
GLUE_RAW_DATABASE=adstart_raw
GLUE_WAREHOUSE_DATABASE=adstart_warehouse

# SNS alert topic — điền ARN sau khi chạy setup_aws.py
# Format: arn:aws:sns:REGION:ACCOUNT_ID:adstart-pipeline-alerts
SNS_ALERT_TOPIC_ARN=arn:aws:sns:eu-west-1:YOUR_ACCOUNT_ID:adstart-pipeline-alerts

# ── AWS Credentials ─────────────────────────────────────────────
# OPTION 1 (Recommended): Dùng IAM role (EC2/ECS/Lambda) → không cần điền
# OPTION 2: Dùng named profile
# AWS_PROFILE=adstart-dev
# OPTION 3: Explicit keys (chỉ dùng local dev, không dùng production)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
