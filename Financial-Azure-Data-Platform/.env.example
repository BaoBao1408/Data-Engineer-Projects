# ════════════════════════════════════════════════════
#  Enterprise Data Platform – Environment Variables
#  Copy to .env and fill in values. Never commit .env!
# ════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────
ENV=development                           # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-random-secret-key
API_KEY=your-api-key-here

# ─── Warehouse DB (PostgreSQL local / Azure SQL prod) ─
WAREHOUSE_DB_USER=edp_user
WAREHOUSE_DB_PASSWORD=edp_pass
WAREHOUSE_DB_NAME=edp_warehouse
WAREHOUSE_DB_HOST=postgres-warehouse
WAREHOUSE_DB_PORT=5432
DATABASE_URL=postgresql://edp_user:edp_pass@postgres-warehouse:5432/edp_warehouse

# ─── Azure SQL (Production) ─────────────────────────
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=edp_prod
AZURE_SQL_USER=edp_admin
AZURE_SQL_PASSWORD=your-azure-sql-password

# ─── Neo4j Knowledge Graph ───────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_pass
# Azure Cosmos DB Gremlin (Production)
COSMOS_GREMLIN_ENDPOINT=wss://your-cosmos.gremlin.cosmos.azure.com:443/
COSMOS_GREMLIN_KEY=your-cosmos-primary-key
COSMOS_DATABASE=edp-graph
COSMOS_GRAPH=entities

# ─── Azure Data Lake Storage Gen2 ───────────────────
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
ADLS_CONTAINER_RAW=raw
ADLS_CONTAINER_PROCESSED=processed
ADLS_CONTAINER_CURATED=curated

# ─── MinIO (Local equivalent of Azure Blob) ──────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret
MINIO_SECURE=false

# ─── Azure Identity ──────────────────────────────────
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# ─── Azure Key Vault ─────────────────────────────────
AZURE_KEY_VAULT_URL=https://your-kv.vault.azure.net/

# ─── Azure Data Factory ──────────────────────────────
ADF_RESOURCE_GROUP=rg-edp-prod
ADF_FACTORY_NAME=adf-edp-prod

# ─── ChromaDB (Vector Store for RAG) ────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_DOCUMENTS=documents
CHROMA_COLLECTION_KNOWLEDGE=knowledge

# ─── OpenAI / Azure OpenAI ───────────────────────────
OPENAI_API_KEY=sk-your-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-01
EMBEDDING_MODEL=text-embedding-ada-002
LLM_MODEL=gpt-4o

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Airflow ─────────────────────────────────────────
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# ─── Monitoring ──────────────────────────────────────
GRAFANA_PASSWORD=grafana_pass
PROMETHEUS_RETENTION=15d
