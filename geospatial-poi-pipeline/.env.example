# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geospatial
DB_USER=geouser
DB_PASSWORD=geopassword

# ── Pipeline ──────────────────────────────────────────────────
TARGET_CITY=Ho Chi Minh City
TARGET_BBOX=10.60,106.40,11.20,107.10
DEDUP_RADIUS_M=20
BATCH_SIZE=500
LOG_LEVEL=INFO
DATA_DIR=./data

# ── OSM ───────────────────────────────────────────────────────
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_TIMEOUT=60
