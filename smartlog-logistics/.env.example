# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=smartlog
POSTGRES_PASSWORD=smartlog123
POSTGRES_DB=smartlog

# ── Kafka ───────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-min-32-characters-long!!
JWT_ISSUER=smartlog-api
JWT_AUDIENCE=smartlog-frontend
JWT_EXPIRE_MINUTES=1440

# ── AWS S3 ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=smartlog-logistics-files

# ── Services ────────────────────────────────────────
ORDER_SERVICE_PORT=5001
TRACKING_SERVICE_PORT=5002
